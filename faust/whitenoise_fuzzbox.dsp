readA(i) = memA, int(i + 2047) : rdtable;
readB(i) = memB, int(i + 2047) : rdtable;

// Index k = trunc(X*Q / 256) (Mode 3: / 4096); Q = 0 acts as X / 160. The oracle truncates the
// exact product (an exact-boundary sample, X = 9488.126 at Q = 127, lands on 4706, which a
// single-precision X*Q would round up to 4707), so it is computed exactly in integers:
// |X|*Q = Ai*Q + Af*Q with Ai = int(|X|), and floor(N/den) = (N - N % den)/den.
qn  = int(select2(q == 0, q, 1));
den = int(select2(q == 0, select2(mode == 3, 256, 4096), 160));

index(X) = sgn * rint(float(n - n % den) / float(den))
with {
  A   = abs(X);
  Ai  = int(A);
  n   = Ai * qn + int((A - float(Ai)) * float(qn));
  sgn = select2(X < 0, 1, -1);
};

shaper(X) = X + tv * level / 32768.0
with {
  k   = int(index(X));
  r   = k % 2048;
  rc  = (k + 512) % 2048;
  tv  = ba.selectn(4, int(mode) - 1,
          readA(r),
          readA(r + 4096),
          readB(r) * min(abs(X), 128.0) / 128.0,
          readA(rc));
};

// 256-sample blocks on a grid restarting every 5250-sample tick (126 BPM, 4 TPB).
blk_start = ((ba.time % 5250) % 256) == 0;

// 1 while every sample of the current block so far has been exactly zero.
silent(x) = (x == 0) : (keep ~ _)
with { keep(prev, z) = z & (blk_start | prev); };

fuzz(x) = shaper(x * 32768.0) / 32768.0 * (1 - silent(x));

process = fuzz, fuzz;
